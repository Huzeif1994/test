{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserStoryPlan",
  "type": "object",
  "required": [
    "id",
    "title",
    "persona",
    "targetProjects",
    "preconditions",
    "scenarios"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "title": {
      "type": "string"
    },
    "persona": {
      "type": "string"
    },
    "targetProjects": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ordering", "fulfillment", "admin", "e2e-bridge", "unit"]
      }
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "authStates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "devices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "store": {
          "type": "string"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["GIVEN", "WHEN", "THEN", "AND"]
                },
                "text": { "type": "string" },
                "targetDomain": {
                  "type": "string",
                  "enum": ["ordering", "fulfillment", "admin", "shared"]
                },
                "suggestedPageObjects": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}

