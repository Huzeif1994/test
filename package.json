{
  "name": "playwright-huzeif",
  "version": "1.0.0",
  "description": "Playwright tests with Docker and CI/CD",
  "scripts": {
    "test": "playwright test",
    "test:ordering": "playwright test --project=ordering",
    "test:admin": "playwright test --project=admin",
    "test:fulfillment": "playwright test --project=fulfillment",
    "test:e2e-bridge": "playwright test --project=e2e-bridge",
    "test:generated": "playwright test --project=generated",
    "test:unit": "playwright test --project=unit",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:changed": "tsx scripts/smart-test-selector.ts --run",
    "test:changed:list": "tsx scripts/smart-test-selector.ts",
    "test:manifest": "tsx scripts/generate-manifest.ts",
    "test:plan": "tsx scripts/ai-planner.ts",
    "test:generate": "tsx scripts/ai-generate.ts",
    "test:heal": "tsx scripts/ai-heal.ts",
    "report:bug": "tsx scripts/generate-bug-report.ts",
    "api:generate-fixtures": "tsx scripts/api/generate-api-fixtures.ts",
    "rag:generate-fixtures": "tsx scripts/api/generate-api-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "quality:check": "tsc --noEmit && npx playwright test --project=unit && tsx scripts/smart-test-selector.ts",
    "quality:gate": "npm run quality:check",
    "report": "playwright show-report",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm playwright",
    "allure:generate": "allure generate allure-results -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:clean": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true});require('fs').rmSync('allure-report',{recursive:true,force:true})\"",
    "docker:allure": "node -e \"const { spawnSync } = require('child_process'); for (const script of ['docker:test', 'allure:generate', 'allure:open']) { const result = spawnSync('npm', ['run', script], { stdio: 'inherit', shell: process.platform === 'win32' }); if (result.error) { console.error(result.error); process.exit(1); } if (result.status !== 0) process.exit(result.status || 1); }\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.4",
    "allure": "^3.33.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "allure": {
      "follow-redirects": "^1.16.3",
      "glob": "^14.0.2",
      "markdown-it": "^14.3.3"
    }
  }
}
